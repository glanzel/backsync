{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backup-Status",
  "version": "0.1.0",
  "identifier": "de.glanzel.backup-status",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Backup-Status",
        "width": 940,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#12151a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
